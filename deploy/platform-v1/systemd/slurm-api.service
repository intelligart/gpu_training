[Unit]
Description=GPU Platform v1 internal Slurm API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hank
Group=hank
WorkingDirectory=/opt/gpu-platform/releases/1.0.1
Environment=PYTHONUNBUFFERED=1
Environment=GPU_PLATFORM_VERSION=1.0.1
Environment=SLURM_CONF=/etc/slurm/slurm.conf
ExecStart=/usr/bin/env /opt/gpu-platform/venvs/1.0.0/bin/python /opt/gpu-platform/releases/1.0.1/slurm_server.py --http --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/storage/SSD2/hank/gpu_training /storage/SSD2/slurmjob /storage/Internal_NAS/logs /storage/Internal_NAS/slurm-recovery /storage/Internal_NAS/slurm-runs /storage/Internal_NAS/slurm-source-cache

[Install]
WantedBy=multi-user.target